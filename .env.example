# Copie para .env e preencha. NUNCA faça commit do .env.
PORT=3001
# Chave para o endpoint administrativo /admin/fail (marca um slot como instável). Deixe vazio para desativar.
ADMIN_KEY=
MAX_CONN_PER_IP=8

# --- Slots de capacidade de jogo (1 App ID Photon = 1 slot de até PHOTON_SLOT_CAPACITY jogadores) ---
# Sem nenhum App ID, o servidor usa um slot local de 20 jogadores (bom para testes).
PHOTON_MAIN_APP_ID=
PHOTON_APP_ID_1=
PHOTON_APP_ID_2=
PHOTON_APP_ID_3=
PHOTON_APP_ID_4=
PHOTON_APP_ID_5=
PHOTON_APP_ID_6=
PHOTON_APP_ID_7=
PHOTON_APP_ID_8=
PHOTON_APP_ID_9=
PHOTON_SLOT_CAPACITY=20

# --- Slots de chat (ficam só no servidor; nunca são enviados ao navegador) ---
CHAT_APP_ID_1=
CHAT_APP_ID_2=
CHAT_APP_ID_3=
CHAT_SLOT_CAPACITY=20
# Palavras extras bloqueadas no chat, separadas por vírgula
CHAT_BLOCKLIST=

# URL do WebSocket do servidor, se o cliente for hospedado separado dele (ex.: wss://meu-servidor.com/ws)
VITE_WS_URL=

# --- Loja e login com Google ---
# Crie em console.cloud.google.com > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web).
# URI de redirecionamento autorizado: PUBLIC_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública do site (sem barra no fim). Local: http://localhost:5173 · Produção: https://SEU-DOMINIO
PUBLIC_URL=http://localhost:5173
# E-mails que moderam a loja (aprovam itens publicados), separados por vírgula
ADMIN_EMAILS=
# Banco SQLite. No Railway, crie um Volume em /data e use DB_PATH=/data/ballfall.db (sem volume, os dados somem a cada deploy)
DB_PATH=data/ballfall.db
# SOMENTE para testar localmente sem Google: DEV_LOGIN=1 libera /auth/dev?email=voce@teste.com (desligado em produção)
DEV_LOGIN=
